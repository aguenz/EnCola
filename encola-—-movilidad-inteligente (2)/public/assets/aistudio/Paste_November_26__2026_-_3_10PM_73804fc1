                        <div className="flex items-center gap-2.5">
                          <span className="w-6 h-6 rounded-lg bg-zinc-900 border border-zinc-700 flex items-center justify-center text-xs font-bold text-amber-400">
                            {index + 1}
                          </span>
                          <div>
                            <p className="text-xs font-bold text-white">
                              {st.name}
                            </p>
                            <p className="text-[10px] text-zinc-500">
                              ETA aprox. {(index + 1) * 3} min
                            </p>
                          </div>
                        </div>
                        <span className="px-2.5 py-1 rounded-lg bg-amber-400/15 text-amber-300 text-xs font-extrabold">
                          {st.waitingCount} esperando
                        </span>
                      </div>
                    ))}
                  </div>
                </div>

                {/* 1-Tap Driver Road Alerts */}
                <div className="bg-zinc-900 border border-zinc-800 rounded-2xl p-4">
                  <h3 className="text-xs font-bold uppercase tracking-wider text-zinc-400 mb-3">
                    Reportes Rápidos de Ruta (1 Toque)
                  </h3>
                  <div className="grid grid-cols-2 gap-2.5">
                    <button
                      onClick={() =>
                        handleDriverAlert('traffic', 'Tráfico fuerte en el canal')
                      }
                      className="p-3 rounded-xl bg-zinc-950 hover:bg-zinc-800 border border-zinc-800 text-left flex items-center gap-2.5"
                    >
                      <AlertTriangle className="w-4 h-4 text-amber-400 shrink-0" />
                      <span className="text-xs font-bold text-zinc-200">
                        Tráfico Fuerte
                      </span>
                    </button>

                    <button
                      onClick={() =>
                        handleDriverAlert('full', 'Unidad llena (sin puestos)')
                      }
                      className="p-3 rounded-xl bg-zinc-950 hover:bg-zinc-800 border border-zinc-800 text-left flex items-center gap-2.5"
                    >
                      <Users className="w-4 h-4 text-rose-400 shrink-0" />
                      <span className="text-xs font-bold text-zinc-200">
                        Unidad Llena
                      </span>
                    </button>

                    <button
                      onClick={() =>
                        handleDriverAlert('detour', 'Desvío activo en vía')
                      }
                      className="p-3 rounded-xl bg-zinc-950 hover:bg-zinc-800 border border-zinc-800 text-left flex items-center gap-2.5"
                    >
                      <Navigation className="w-4 h-4 text-sky-400 shrink-0" />
                      <span className="text-xs font-bold text-zinc-200">
                        Desvío en Vía
                      </span>
                    </button>

                    <button
                      onClick={() =>
                        handleDriverAlert('checkpoint', 'Alcabala / Control vial')
                      }
                      className="p-3 rounded-xl bg-zinc-950 hover:bg-zinc-800 border border-zinc-800 text-left flex items-center gap-2.5"
                    >
                      <ShieldAlert className="w-4 h-4 text-emerald-400 shrink-0" />
                      <span className="text-xs font-bold text-zinc-200">
                        Alcabala / Control
                      </span>
                    </button>
                  </div>
                </div>
              </>
            )}
          </div>
        )}

        {/* ==================================================================== */}
        {/* TAB 3: COMERCIOS Y CANJES (EXCLUSIVELY FOR PASSENGERS)                */}
        {/* ==================================================================== */}
        {activeTab === 'rewards' && role === 'passenger' && (
          <div className="p-4 space-y-4">
            {/* Points Balance Banner */}
            <div className="bg-gradient-to-br from-emerald-500/20 via-zinc-900 to-amber-500/15 border border-emerald-500/30 rounded-2xl p-4 flex items-center justify-between">
              <div>
                <span className="text-[11px] font-semibold text-emerald-400 uppercase tracking-wider">
                  Saldo Disponible
                </span>
                <div className="flex items-baseline gap-1.5 mt-0.5">
                  <span className="text-3xl font-black text-white">{points}</span>
                  <span className="text-xs font-bold text-amber-400">Pts RutaVía</span>
                </div>
                <p className="text-[11px] text-zinc-400 mt-1">
                  Ganas +25 pts cada vez que validas tu viaje a bordo
                </p>
              </div>
              <div className="w-12 h-12 rounded-2xl bg-amber-400/20 border border-amber-400/40 flex items-center justify-center text-amber-300">
                <Award className="w-6 h-6" />
              </div>
            </div>

            {/* Merchant Catalog */}
            <div>
              <h3 className="text-xs font-bold uppercase tracking-wider text-zinc-400 mb-3">
                Comercios Aliados Cerca de Paradas
              </h3>
              <div className="space-y-3">
                {MERCHANTS.map((merchant) => {
                  const canAfford = points >= merchant.pointsCost;
                  return (
                    <div
                      key={merchant.id}
                      className="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex flex-col gap-3"
                    >
                      <div className="flex items-start justify-between gap-2">
                        <div>
                          <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">
                            {merchant.category} • {merchant.stopName}
                          </span>
                          <h4 className="text-sm font-bold text-white mt-1.5">
                            {merchant.name}
                          </h4>
                          <p className="text-xs text-emerald-400 font-semibold">
                            {merchant.offer}
                          </p>
                          <p className="text-[11px] text-zinc-500 mt-0.5">
                            {merchant.distance}
                          </p>
                        </div>

                        <div className="text-right shrink-0">
                          <span className="text-sm font-extrabold text-amber-400">
                            {merchant.pointsCost}
                          </span>
                          <span className="block text-[10px] text-zinc-400">
                            puntos
                          </span>
                        </div>
                      </div>

                      <button
                        onClick={() => handleRedeemMerchant(merchant)}
                        disabled={!canAfford}
                        className={`w-full py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition-all ${
                          canAfford
                            ? 'bg-emerald-500 hover:bg-emerald-400 text-zinc-950'
                            : 'bg-zinc-950 text-zinc-600 border border-zinc-800 cursor-not-allowed'
                        }`}
                      >
                        <QrCode className="w-4 h-4" />
                        {canAfford
                          ? 'Canjear Cupón QR'
                          : `Faltan ${merchant.pointsCost - points} pts`}
                      </button>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        )}

        {/* QR Coupon Modal (Passenger Only) */}
        {redeemedMerchant && (
          <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
            <div className="bg-zinc-900 border border-emerald-500/40 rounded-3xl p-6 max-w-xs w-full text-center relative">
              <button
                onClick={() => setRedeemedMerchant(null)}
                className="absolute top-4 right-4 p-1.5 rounded-full bg-zinc-800 text-zinc-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>

              <div className="w-12 h-12 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-3">
                <CheckCircle2 className="w-7 h-7" />
              </div>

              <h3 className="text-base font-extrabold text-white">
                ¡Cupón Generado!
              </h3>
              <p className="text-xs text-zinc-400 mt-1">
                Muestra este código en{' '}
                <span className="text-white font-semibold">
                  {redeemedMerchant.name}
                </span>
              </p>

              <div className="my-4 bg-white p-4 rounded-2xl inline-flex flex-col items-center">
                <QrCode className="w-32 h-32 text-zinc-950 stroke-[1.6]" />
                <span className="mt-2 text-xs font-mono font-extrabold text-zinc-950 tracking-wider">
                  {redeemedMerchant.code}
                </span>
              </div>

              <p className="text-xs font-bold text-emerald-400 mb-4">
                {redeemedMerchant.offer}
              </p>

              <button
                onClick={() => setRedeemedMerchant(null)}
                className="w-full py-2.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-xs font-bold text-white"
              >
                Listo
              </button>
            </div>
          </div>
        )}

        {/* Bottom Navigation Bar (Adapts dynamically: 3 tabs for Passenger, 2 for Driver) */}
        <nav className="fixed bottom-0 w-full max-w-md bg-zinc-950/95 backdrop-blur-md border-t border-zinc-900 px-3 py-2 z-30">
          <div
            className={`grid ${
              role === 'passenger' ? 'grid-cols-3' : 'grid-cols-2'
            } gap-1`}
          >
            <button
              onClick={() => setActiveTab('map')}
              className={`flex flex-col items-center justify-center py-1.5 rounded-xl transition-all ${
                activeTab === 'map'
                  ? role === 'passenger'
                    ? 'text-emerald-400 bg-emerald-500/10'
                    : 'text-amber-400 bg-amber-400/10'
                  : 'text-zinc-500 hover:text-zinc-300'
              }`}
            >
              <MapPin className="w-5 h-5" />
              <span className="text-[10px] font-bold mt-1">Mapa en Vivo</span>
            </button>

            <button
              onClick={() => setActiveTab('route')}
              className={`flex flex-col items-center justify-center py-1.5 rounded-xl transition-all ${
                activeTab === 'route'
                  ? role === 'passenger'
                    ? 'text-emerald-400 bg-emerald-500/10'
                    : 'text-amber-400 bg-amber-400/10'
                  : 'text-zinc-500 hover:text-zinc-300'
              }`}
            >
              <Navigation className="w-5 h-5" />
              <span className="text-[10px] font-bold mt-1">
                {role === 'passenger' ? 'Unidades y ETA' : 'Ruta y Demanda'}
              </span>
            </button>

            {role === 'passenger' && (
              <button
                onClick={() => setActiveTab('rewards')}
                className={`flex flex-col items-center justify-center py-1.5 rounded-xl transition-all ${
                  activeTab === 'rewards'
                    ? 'text-amber-400 bg-amber-400/10'
                    : 'text-zinc-500 hover:text-zinc-300'
                }`}
              >
                <Gift className="w-5 h-5" />
                <span className="text-[10px] font-bold mt-1">Comercios</span>
              </button>
            )}
          </div>
        </nav>
      </div>
    </div>
  );
}
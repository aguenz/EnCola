function interpolatePosition(progress: number) {
  const scaled = progress * (STOPS.length - 1);
  const idx = Math.min(Math.floor(scaled), STOPS.length - 2);
  const t = scaled - idx;
  const s1 = STOPS[idx];
  const s2 = STOPS[idx + 1];
  return {
    lat: s1.lat + (s2.lat - s1.lat) * t,
    lng: s1.lng + (s2.lng - s1.lng) * t,
    xPercent: s1.xPercent + (s2.xPercent - s1.xPercent) * t,
    yPercent: s1.yPercent + (s2.yPercent - s1.yPercent) * t,
    nextStopIndex: idx + 1,
  };
}


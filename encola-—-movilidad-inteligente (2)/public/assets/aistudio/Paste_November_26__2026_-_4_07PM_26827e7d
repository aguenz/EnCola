                    <div>
                      <span className="text-[10px] font-semibold text-zinc-400">
                        {merchant.stopName} • {merchant.distance}
                      </span>
                      <h4 className="text-sm font-bold text-white mt-0.5">
                        {merchant.name}
                      </h4>
                      <p className="text-xs text-emerald-400 font-medium">
                        {merchant.offer}
                      </p>
                    </div>

                    <button
                      onClick={() => handleRedeemMerchant(merchant)}
                      disabled={!canAfford}
                      className={`px-3.5 py-2.5 rounded-2xl text-xs font-bold shrink-0 transition-all active:scale-95 ${
                        canAfford
                          ? 'bg-emerald-500 hover:bg-emerald-400 text-zinc-950'
                          : 'bg-zinc-950 text-zinc-600 border border-white/5 cursor-not-allowed'
                      }`}
                    >
                      {merchant.pointsCost} pts
                    </button>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* QR Modal */}
        {redeemedMerchant && (
          <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 animate-fade-up">
            <div className="bg-zinc-900 border border-white/10 rounded-3xl p-6 max-w-xs w-full text-center relative">
              <button
                onClick={() => setRedeemedMerchant(null)}
                className="absolute top-4 right-4 p-1.5 rounded-full bg-zinc-800 text-zinc-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>

              <CheckCircle2 className="w-10 h-10 text-emerald-400 mx-auto mb-2" />
              <h3 className="text-base font-bold text-white">
                {redeemedMerchant.name}
              </h3>
              <p className="text-xs text-emerald-400 mt-0.5">
                {redeemedMerchant.offer}
              </p>

              <div className="my-5 bg-white p-4 rounded-2xl inline-flex flex-col items-center">
                <QrCode className="w-32 h-32 text-zinc-950 stroke-[1.6]" />
                <span className="mt-2 text-xs font-mono font-bold text-zinc-950">
                  {redeemedMerchant.code}
                </span>
              </div>

              <button
                onClick={() => setRedeemedMerchant(null)}
                className="w-full py-2.5 rounded-2xl bg-zinc-800 hover:bg-zinc-700 text-xs font-bold text-white"
              >
                Cerrar
              </button>
            </div>
          </div>
        )}

        {/* Bottom Navigation Bar */}
        <nav className="relative z-30 bg-[#09090b]/95 backdrop-blur-xl border-t border-white/5 px-6 py-2.5 shrink-0">
          <div
            className={`grid ${
              role === 'passenger' ? 'grid-cols-3' : 'grid-cols-2'
            } gap-2`}
          >
            <button
              onClick={() => setActiveTab('map')}
              className={`flex flex-col items-center justify-center py-1 rounded-2xl transition-all ${
                activeTab === 'map'
                  ? role === 'passenger'
                    ? 'text-emerald-400'
                    : 'text-amber-400'
                  : 'text-zinc-500 hover:text-zinc-300'
              }`}
            >
              <MapPin className="w-5 h-5" />
              <span className="text-[10px] font-bold mt-1">Mapa</span>
            </button>

            <button
              onClick={() => setActiveTab('route')}
              className={`flex flex-col items-center justify-center py-1 rounded-2xl transition-all ${
                activeTab === 'route'
                  ? role === 'passenger'
                    ? 'text-emerald-400'
                    : 'text-amber-400'
                  : 'text-zinc-500 hover:text-zinc-300'
              }`}
            >
              <Navigation className="w-5 h-5" />
              <span className="text-[10px] font-bold mt-1">
                {role === 'passenger' ? 'Unidades' : 'Operación'}
              </span>
            </button>

            {role === 'passenger' && (
              <button
                onClick={() => setActiveTab('rewards')}
                className={`flex flex-col items-center justify-center py-1 rounded-2xl transition-all ${
                  activeTab === 'rewards'
                    ? 'text-amber-400'
                    : 'text-zinc-500 hover:text-zinc-300'
                }`}
              >
                <Gift className="w-5 h-5" />
                <span className="text-[10px] font-bold mt-1">Beneficios</span>
              </button>
            )}
          </div>
        </nav>
      </div>
    </div>
  );
}